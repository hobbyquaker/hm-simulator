{
  "name": "hm-simulator",
  "version": "1.4.0",
  "description": "Simulates a Homematic CCU (rfd, hmipserver, VirtualDevices, CUxD, ReGa) for automated tests",
  "main": "sim.js",
  "types": "./sim.d.ts",
  "preferGlobal": true,
  "bin": {
    "hm-simulator": "./index.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "node --test test/*.test.js && npm run test:types",
    "test:watch": "node --test --watch test/*.test.js",
    "fixtures": "node tools/fixtures-from-paramsets.js",
    "test:types": "tsc -p test/types"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hobbyquaker/hm-simulator.git"
  },
  "keywords": [
    "Homematic",
    "Test",
    "Simulator",
    "CCU",
    "rfd",
    "HmIP",
    "xmlrpc",
    "binrpc"
  ],
  "author": "Sebastian Raff <hobbyquaker@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/hobbyquaker/hm-simulator/issues"
  },
  "homepage": "https://github.com/hobbyquaker/hm-simulator#readme",
  "files": [
    "index.js",
    "sim.js",
    "sim.mjs",
    "sim.d.ts",
    "sim.d.mts",
    "lib/",
    "data/",
    "behaviors/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "binrpc": "^4.2.0",
    "homematic-xmlrpc": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
